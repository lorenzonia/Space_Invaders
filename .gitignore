*.drawio
*.drawio.bkp
*~*.drawio

# Ignora arquivos temporários e ocultos de edição do Draw.io (ex: .$fluxo.drawio.bkp)
.*.drawio.bkp
.*.drawio.crswap

# Ignora todas as imagens globais (evita sujeira de prints de teste)
*.png
*.jpg
*.jpeg
*.gif

